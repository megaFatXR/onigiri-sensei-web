      <Image src={cardImasu} width={250} densities={[1, 2, 3]} quality={90} alt="To exist card" />
      <Image src={cardHanasu} width={255} densities={[1, 2, 3]} quality={90} alt="To speak card" />
      <Image src={cardTakushii} width={225} densities={[1, 2, 3]} quality={90} alt="Taxi card" />
