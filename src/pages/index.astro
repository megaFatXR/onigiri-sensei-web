  </section>

  <!-- SCREENSHOTS -->
  <section class="screenshots-section">
    <div class="screenshots-heading">
      <h2>Everything you need<br>to master Japanese</h2>
      <p>Study, drill conjugations, quiz yourself — and track your progress.</p>
    </div>

    <!-- feature grid: 2×2 on desktop, stacked on mobile -->
    <div class="features-grid">

      <article class="feature-row f-vocab">
        <div class="feature-media">
          <Image class="feature-card" src={cardImasu} width={200} densities={[1, 2, 3]} quality={90} alt="Illustrated vocabulary card" />
        </div>
        <div class="feature-copy">
          <span class="tag">Vocabulary</span>
          <h3>Every word, illustrated.</h3>
          <p>Vivid scenes make vocabulary impossible to forget.</p>
        </div>
      </article>

      <article class="feature-row f-conj">
        <div class="feature-media">
          <div class="phone">
            <div class="phone-screen">
              <Image src={screenCardFlipped} width={200} densities={[1, 2, 3]} quality={90} alt="Conjugation screen" />
            </div>
          </div>
        </div>
        <div class="feature-copy">
          <span class="tag">Conjugation</span>
          <h3>More than flashcards.</h3>
          <p>Plain, polite, past, te, tai — drill every form you actually need.</p>
        </div>
      </article>

      <article class="feature-row f-quiz">
        <div class="feature-media">
          <div class="phone">
            <div class="phone-screen">
              <Image src={screenQuiz} width={200} densities={[1, 2, 3]} quality={90} alt="Quiz screen" />
            </div>
          </div>
        </div>
        <div class="feature-copy">
          <span class="tag">Quiz Mode</span>
          <h3>Test what you know.</h3>
          <p>Four choices. One right answer. No cheating yourself.</p>
        </div>
      </article>

      <article class="feature-row f-progress">
        <div class="feature-media">
          <div class="phone">
            <div class="phone-screen">
              <Image src={screenStatsWord} width={200} densities={[1, 2, 3]} quality={90} alt="Word stats screen" />
            </div>
          </div>
        </div>
        <div class="feature-copy">
          <span class="tag">Progress</span>
          <h3>Watch yourself level up.</h3>
          <p>Track accuracy, deck mastery, and every word individually.</p>
        </div>
      </article>

    </div>
  </section>

