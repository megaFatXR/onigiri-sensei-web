---
import { Image } from 'astro:assets';
import cardHanasu from '../assets/card-hanasu.png';
import cardImasu from '../assets/card-imasu.png';
import cardJitensha from '../assets/card-jitensha.png';
import cardTakushii from '../assets/card-takushii.png';
import cardOkiru from '../assets/card-okiru.png';
import screenCardFlipped from '../assets/screen-card-flipped.png';
import screenQuiz from '../assets/screen-quiz.png';
import screenStatsWord from '../assets/screen-stats-word.png';

const appStoreUrl = 'https://apps.apple.com/us/app/onigiri-sensei/id6770698062';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>Onigiri Sensei — Learn Japanese</title>
  <meta name="description" content="Learn Japanese with Onigiri Sensei — illustrated vocabulary cards and conjugation drills with your adorable rice ball guide." />
  <link rel="canonical" href="https://onigirisensei.app/" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-itunes-app" content="app-id=6770698062" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://onigirisensei.app/" />
  <meta property="og:site_name" content="Onigiri Sensei" />
  <meta property="og:title" content="Onigiri Sensei — Learn Japanese" />
  <meta property="og:description" content="Illustrated vocabulary cards, conjugation drills, quizzes and progress tracking — with your adorable rice ball sensei. Now on iOS." />
  <meta property="og:image" content="https://onigirisensei.app/og-image.jpg" />
  <meta property="og:image:width" content="2400" />
  <meta property="og:image:height" content="1260" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Onigiri Sensei — Learn Japanese" />
  <meta name="twitter:description" content="Illustrated vocabulary cards, conjugation drills, quizzes and progress tracking — with your adorable rice ball sensei. Now on iOS." />
  <meta name="twitter:image" content="https://onigirisensei.app/og-image.jpg" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Onigiri Sensei',
    operatingSystem: 'iOS',
    applicationCategory: 'EducationalApplication',
    description: 'Learn Japanese with illustrated vocabulary cards, conjugation drills, quizzes and progress tracking.',
    url: 'https://onigirisensei.app/',
    installUrl: appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --cream:    #FDF6E8;
      --cream-mid: #F5E9CF;
      --cream-deep: #EDDAB4;
      --gold:     #C8943A;
      --gold-dark: #B07D2E;
      --brown:    #2C1A06;
      --brown-mid: #7A5428;
      --dark:     #0E0E0E;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Nunito', system-ui, sans-serif;
      background: var(--cream);
      color: var(--brown);
    }

    /* ─── NAV ─── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(253, 246, 232, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(200, 148, 58, 0.15);
      padding: 0 40px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-logo {
      font-size: 18px;
      font-weight: 900;
      color: var(--brown);
      text-decoration: none;
      letter-spacing: -0.3px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 700;
      color: var(--brown-mid);
      text-decoration: none;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--gold); }

    /* ─── HERO ─── */
    .hero {
      position: relative;
      overflow: hidden;
      min-height: calc(100vh - 60px);
      background: linear-gradient(150deg, #FEF8EE 0%, var(--cream-mid) 55%, var(--cream-deep) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 40px;
      gap: 60px;
    }

    /* ambient oversized kana behind the content */
    .hero::before,
    .hero::after {
      position: absolute;
      font-weight: 900;
      line-height: 1;
      color: rgba(176, 125, 46, 0.07);
      pointer-events: none;
      user-select: none;
    }

    .hero::before {
      content: 'あ';
      font-size: clamp(280px, 38vw, 560px);
      top: -60px;
      right: -70px;
    }

    .hero::after {
      content: '語';
      font-size: clamp(200px, 26vw, 380px);
      bottom: -70px;
      left: -50px;
    }

    .hero-text {
      max-width: 500px;
      flex-shrink: 0;
      position: relative;
      z-index: 2;
    }

    .hero-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold-dark);
      margin-bottom: 20px;
    }

    .hero-h1 {
      font-size: clamp(48px, 6vw, 72px);
      font-weight: 900;
      color: var(--brown);
      line-height: 1.06;
      margin-bottom: 20px;
    }

    .hero-sub {
      font-size: 18px;
      font-weight: 600;
      color: var(--brown-mid);
      line-height: 1.65;
      margin-bottom: 36px;
      max-width: 400px;
    }

    .app-store-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--brown);
      color: #fff;
      text-decoration: none;
      padding: 14px 28px;
      border-radius: 50px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.2px;
      transition: transform 0.2s, background 0.2s;
    }

    .app-store-btn:hover {
      background: #1a0a00;
      transform: translateY(-2px);
    }

    .app-store-btn svg {
      width: auto;
      height: 22px;
      fill: currentColor;
    }

    /* download row: badge + QR */
    .hero-cta {
      display: flex;
      align-items: center;
      gap: 22px;
      flex-wrap: wrap;
    }

    .hero-qr {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .qr-card {
      width: 104px;
      height: 104px;
      background: #fff;
      border: 1px solid rgba(200, 148, 58, 0.3);
      border-radius: 16px;
      padding: 11px;
      box-shadow: 0 10px 30px rgba(90, 50, 0, 0.12);
      flex-shrink: 0;
    }

    .qr-card svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .hero-qr-label {
      font-size: 13px;
      font-weight: 800;
      line-height: 1.3;
      color: var(--brown-mid);
      max-width: 90px;
    }

    /* feature chips under the CTA */
    .hero-features {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      margin-top: 28px;
    }

    .hero-features li {
      font-size: 13px;
      font-weight: 700;
      color: var(--brown-mid);
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid rgba(200, 148, 58, 0.25);
      border-radius: 999px;
      padding: 7px 14px;
    }

    /* hero cards — floating fan on the right */
    .hero-cards {
      position: relative;
      z-index: 1;
      width: 660px;
      height: 510px;
      flex-shrink: 0;
    }

    .hero-cards img {
      position: absolute;
      height: auto;
      filter: drop-shadow(0 20px 50px rgba(90, 50, 0, 0.22));
      --tx: 0px;
      --r: 0deg;
      transform: translateX(var(--tx)) rotate(var(--r));
      animation: card-float 7s ease-in-out infinite;
    }

    @keyframes card-float {
      0%, 100% { transform: translateX(var(--tx)) rotate(var(--r)) translateY(0); }
      50%      { transform: translateX(var(--tx)) rotate(var(--r)) translateY(-12px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-cards img { animation: none; }
    }

    .hero-cards img:nth-child(1) {
      width: 225px;
      left: -10px;
      bottom: 32px;
      --r: -16deg;
      z-index: 3;
      animation-delay: -1.5s;
    }

    .hero-cards img:nth-child(2) {
      width: 255px;
      left: 105px;
      bottom: 0;
      --r: -7deg;
      z-index: 2;
      animation-delay: -4.5s;
    }

    .hero-cards img:nth-child(3) {
      width: 250px;
      left: 50%;
      top: 0;
      --tx: -50%;
      z-index: 1;
    }

    .hero-cards img:nth-child(4) {
      width: 255px;
      right: 105px;
      bottom: 0;
      --r: 7deg;
      z-index: 2;
      animation-delay: -3s;
    }

    .hero-cards img:nth-child(5) {
      width: 225px;
      right: -10px;
      bottom: 32px;
      --r: 16deg;
      z-index: 3;
      animation-delay: -6s;
    }

    /* tighter 3-card fan on small screens */
    @media (max-width: 860px) {
      .hero { flex-direction: column; text-align: center; }
      .hero::before { font-size: 280px; top: -40px; right: -90px; }
      .hero::after { font-size: 200px; bottom: -50px; left: -70px; }
      .hero-text { max-width: 100%; }
      .hero-sub { margin-left: auto; margin-right: auto; }
      .hero-cta { justify-content: center; }
      .hero-qr { display: none; }
      .hero-features { justify-content: center; }
      .hero-cards { order: -1; width: 340px; height: 400px; max-width: 100%; }
      .hero-cards img:nth-child(1),
      .hero-cards img:nth-child(5) { display: none; }
      .hero-cards img:nth-child(2) { width: 185px; left: 0; }
      .hero-cards img:nth-child(3) { width: 220px; }
      .hero-cards img:nth-child(4) { width: 185px; right: 0; }
    }

    /* ─── SCREENSHOTS SECTION ─── */
    .screenshots-section {
      background: var(--dark);
      padding: 80px 0 100px;
      overflow: hidden;
    }

    .screenshots-heading {
      text-align: center;
      padding: 0 40px;
      margin-bottom: 56px;
    }

    .screenshots-heading h2 {
      font-size: clamp(30px, 4vw, 46px);
      font-weight: 900;
      color: #fff;
      line-height: 1.1;
      margin-bottom: 14px;
    }

    .screenshots-heading p {
      font-size: 17px;
      font-weight: 600;
      color: #6A7A8A;
      line-height: 1.6;
    }

    .phone {
      position: relative;
      background: #141414;
      border-radius: 48px;
      padding: 11px;
      box-shadow:
        0 0 0 1px #2C2C2C,
        0 40px 100px rgba(0,0,0,0.5),
        inset 0 0 0 2px rgba(255,255,255,0.04);
    }

    .phone::before {
      content: '';
      position: absolute;
      top: 15px;
      left: 50%;
      transform: translateX(-50%);
      width: 88px;
      height: 26px;
      background: #000;
      border-radius: 18px;
      z-index: 10;
    }

    .phone-screen {
      border-radius: 38px;
      overflow: hidden;
      background: #E5E5EA;
    }

    .phone-screen img {
      width: 100%;
      display: block;
    }

    .tag {
      display: block;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }


    /* ─── FEATURES GRID (image beside text; 2×2 desktop, stacked mobile) ─── */
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .feature-row {
      display: flex;
      align-items: center;
      gap: 26px;
      border-radius: 24px;
      padding: 30px 28px;
    }

    .feature-row:nth-child(even) { flex-direction: row-reverse; }

    /* media breaks out of the box edges, sticker-style */
    .feature-media {
      flex: 0 0 38%;
      max-width: 210px;
      margin: -22px 0;
      position: relative;
      z-index: 1;
    }

    .feature-row:nth-child(odd) .feature-media { margin-left: -52px; }
    .feature-row:nth-child(even) .feature-media { margin-right: -52px; }

    .feature-media img {
      width: 100%;
      height: auto;
      display: block;
    }

    .feature-card {
      transform: rotate(-5deg);
      filter: drop-shadow(0 10px 24px rgba(90, 50, 0, 0.25));
    }

    .feature-media .phone {
      border-radius: 26px;
      padding: 6px;
      transform: rotate(4deg);
    }

    .feature-row:nth-child(even) .feature-media .phone { transform: rotate(-4deg); }
    .feature-row:nth-child(4) .feature-media .phone { transform: rotate(4deg); }

    .feature-media .phone::before {
      top: 9px;
      width: 40px;
      height: 12px;
      border-radius: 8px;
    }

    .feature-media .phone-screen { border-radius: 20px; }

    .feature-copy { flex: 1; min-width: 0; }
    .feature-copy .tag { font-size: 13px; letter-spacing: 2.5px; margin-bottom: 8px; }
    .feature-copy h3 { font-size: 26px; font-weight: 900; line-height: 1.15; margin-bottom: 10px; }
    .feature-copy p { font-size: 15px; font-weight: 600; line-height: 1.6; }

    .f-vocab { background: linear-gradient(162deg, #FFFBF0 0%, #F9EDCC 100%); }
    .f-vocab .tag { color: #B07D2E; }
    .f-vocab h3 { color: #2C1A06; }
    .f-vocab p { color: #7A5428; }

    .f-conj { background: linear-gradient(158deg, #EEF6EE 0%, #BCE0BE 100%); }
    .f-conj .tag { color: #2A7A2E; }
    .f-conj h3 { color: #19391A; }
    .f-conj p { color: #3A6440; }

    .f-quiz { background: linear-gradient(158deg, #FFF6EE 0%, #FFD0A0 100%); }
    .f-quiz .tag { color: #C84C08; }
    .f-quiz h3 { color: #2C1000; }
    .f-quiz p { color: #7A3808; }

    .f-progress { background: linear-gradient(158deg, #1C2236 0%, #0D1220 100%); }
    .f-progress .tag { color: #5AABF0; }
    .f-progress h3 { color: #fff; }
    .f-progress p { color: #8FA4C0; }

    @media (max-width: 860px) {
      .screenshots-section { padding: 56px 0 64px; }
      .screenshots-heading { margin-bottom: 36px; padding: 0 24px; }

      .features-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 0 20px;
      }

      .feature-row { gap: 20px; padding: 24px 20px; }
      .feature-media { max-width: 170px; margin: -14px 0; }
      .feature-row:nth-child(odd) .feature-media { margin-left: -34px; }
      .feature-row:nth-child(even) .feature-media { margin-right: -34px; }
      .feature-copy h3 { font-size: 22px; margin-bottom: 8px; }
      .feature-copy p { font-size: 14px; line-height: 1.55; }
    }

    /* ─── FOOTER ─── */
    footer {
      background: var(--cream-mid);
      border-top: 1px solid rgba(200,148,58,0.2);
      padding: 32px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-copy {
      font-size: 13px;
      font-weight: 600;
      color: var(--brown-mid);
    }

    .footer-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .footer-links a {
      font-size: 13px;
      font-weight: 700;
      color: var(--brown-mid);
      text-decoration: none;
    }

    .footer-links a:hover { color: var(--gold); }
  </style>
</head>

<body>

  <!-- NAV -->
  <nav>
    <a class="nav-logo" href="/">Onigiri Sensei</a>
    <ul class="nav-links">
      <li><a href="/privacy-policy">Privacy Policy</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <span class="hero-badge">Now available on iOS</span>
      <h1 class="hero-h1">Japanese<br>that sticks.</h1>
      <p class="hero-sub">
        Meet your new Japanese tutor. He's adorable,
        he's dedicated, and he's made of rice.
      </p>
      <div class="hero-cta">
        <a class="app-store-btn" href={appStoreUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C72.5 141.2 16 184.8 16 273.5c0 26.2 4.8 53.3 14.4 81.2 12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
          </svg>
          Download on the App Store
        </a>

        <a class="hero-qr" href={appStoreUrl} target="_blank" rel="noopener" aria-label="Scan or tap to download Onigiri Sensei on the App Store">
          <div class="qr-card">
            <svg viewBox="0 0 41 41" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="QR code linking to Onigiri Sensei on the App Store">
